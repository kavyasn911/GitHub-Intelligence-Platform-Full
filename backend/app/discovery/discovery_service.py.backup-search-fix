from backend.app.search.advanced_search import AdvancedSearchService
from backend.app.discovery.requirement_intelligence import RequirementIntelligenceService
from backend.app.discovery.github_search import GlobalGitHubSearchService
from backend.app.discovery.external_analyzer import ExternalRepositoryAnalyzer
from backend.app.discovery.external_ranking import ExternalRepositoryRankingService
from backend.app.discovery.reuse_recommendation import RepositoryReuseRecommendationService
from backend.app.discovery.recommendation_synthesis import DiscoveryRecommendationSynthesisService
from backend.app.discovery.relevance_filter import RepositoryRelevanceFilter


class RepositoryDiscoveryService:

    def __init__(self):
        self.internal_search = AdvancedSearchService()
        self.requirement_intelligence = RequirementIntelligenceService()
        self.github_search = GlobalGitHubSearchService()
        self.external_analyzer = ExternalRepositoryAnalyzer()
        self.external_ranking = ExternalRepositoryRankingService()
        self.reuse_service = RepositoryReuseRecommendationService()
        self.synthesis_service = DiscoveryRecommendationSynthesisService()
        self.relevance_filter = RepositoryRelevanceFilter()

    def discover(
        self,
        query: str,
        internal_limit: int = 5,
        external_limit: int = 10,
        result_limit: int = 5,
        synthesize: bool = True,
    ) -> dict:

        requirement_result = self.requirement_intelligence.analyze(query)

        specification = requirement_result.get(
            "specification",
            {},
        )

        semantic_query = (
            self.requirement_intelligence.build_semantic_query(
                requirement_result
            )
        )

        search_queries = self._build_search_queries(
            query=query,
            specification=specification,
        )

        internal_results = self.internal_search.search(
            query=semantic_query or query,
            limit=internal_limit,
        )

        external_search = self.github_search.search(
            queries=search_queries,
            limit=external_limit,
        )

        analyzed_repositories = []

        for repository in external_search.get(
            "repositories",
            [],
        ):
            analyzed_repositories.append(
                self.external_analyzer.analyze(repository)
            )

        relevance_result = self.relevance_filter.filter(
            query=semantic_query or query,
            repositories=analyzed_repositories,
            minimum_overlap=1,
        )

        relevant_repositories = relevance_result.get(
            "accepted",
            [],
        )

        ranked_repositories = self.external_ranking.rank(
            query=semantic_query or query,
            repositories=relevant_repositories,
            specification=specification,
        )

        recommendations = []

        for repository in ranked_repositories[:result_limit]:
            recommendations.append({
                **repository,
                "reuse_intelligence": self.reuse_service.recommend(
                    repository=repository,
                    query=semantic_query or query,
                ),
            })

        best_candidate = (
            recommendations[0]
            if recommendations
            else None
        )

        discovery_result = {
            "status": "success",
            "query": query,
            "strategy": "universal_requirement_driven_discovery",
            "requirement_intelligence": {
                "mode": requirement_result.get("mode"),
                "provider": requirement_result.get("provider"),
                "model": requirement_result.get("model"),
                "specification": specification,
                "semantic_query": semantic_query,
            },
            "query_plan": {
                "original_query": query,
                "search_queries": search_queries,
                "query_count": len(search_queries),
            },
            "internal_repository_matches": internal_results,
            "github_search": {
                "candidate_pool_size": external_search.get(
                    "count",
                    0,
                ),
                "queries_executed": external_search.get(
                    "queries",
                    [],
                ),
                "errors": external_search.get(
                    "errors",
                    [],
                ),
            },
            "relevance_filter": {
                "accepted_count": relevance_result.get(
                    "accepted_count",
                    0,
                ),
                "rejected_count": relevance_result.get(
                    "rejected_count",
                    0,
                ),
            },
            "external_candidate_count": len(recommendations),
            "best_external_candidate": best_candidate,
            "external_recommendations": recommendations,
        }

        if synthesize:
            discovery_result["ai_recommendation"] = (
                self.synthesis_service.synthesize(
                    query=query,
                    discovery_result=discovery_result,
                )
            )

        return discovery_result

    def _build_search_queries(
        self,
        query: str,
        specification: dict,
    ) -> list[str]:

        search_queries = []

        for concept in specification.get(
            "search_concepts",
            [],
        ):
            if concept:
                search_queries.append(str(concept).strip())

        core_capabilities = specification.get(
            "core_capabilities",
            [],
        )

        technologies = specification.get(
            "technologies",
            [],
        )

        if core_capabilities:
            search_queries.append(
                " ".join(
                    str(item)
                    for item in core_capabilities[:4]
                )
            )

        if technologies:
            search_queries.append(
                " ".join(
                    str(item)
                    for item in technologies[:5]
                )
            )

        if core_capabilities and technologies:
            search_queries.append(
                " ".join([
                    *[
                        str(item)
                        for item in core_capabilities[:3]
                    ],
                    *[
                        str(item)
                        for item in technologies[:3]
                    ],
                ])
            )

        project_type = specification.get("project_type")

        if project_type:
            search_queries.append(str(project_type).strip())

        search_queries.append(query)

        return list(
            dict.fromkeys(
                item
                for item in search_queries
                if item
            )
        )

